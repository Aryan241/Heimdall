# === Data & artifacts (never committed) ===
data/
checkpoints/*
outputs/
*.tif
*.tiff
*.hgt

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so

# === Virtual environments ===
venv/
.venv/
env/
.env

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# === Jupyter ===
.ipynb_checkpoints/

# === PyTorch / ML ===
*.pt
*.pth
*.ckpt
*.onnx
wandb/
runs/
lightning_logs/

# === OS ===
Thumbs.db
ehthumbs.db

# === Node (frontend) ===
node_modules/

# Processed jobs live here while the app runs. Never delete this directory to tidy up: it holds
# work the user may still have open in a browser, and it is ignored anyway so it never needs
# cleaning for a commit.
outputs/jobs/

# === Shipped artefacts (exceptions to the rules above) ===
# The trained head the pipeline loads by default, so a clone runs out of the box.
!checkpoints/decoder/
checkpoints/decoder/*
!checkpoints/decoder/decoder_best.pth

# The measured results every number in the documentation is read from. These are small JSON
# and Markdown; the rasters and meshes they were computed from stay out of the repository.
!outputs/
outputs/*
!outputs/benchmark_ahn/
outputs/benchmark_ahn/*
!outputs/benchmark_ahn/results.json
!outputs/benchmark_ahn/results.md
!outputs/benchmark_gsd/
outputs/benchmark_gsd/*
!outputs/benchmark_gsd/results.json
!outputs/benchmark_gsd/results.md
!outputs/gamus_test.json
!outputs/gamus_architecture_comparison.json
!outputs/evaluation_envelope.json

# Bundled demo scene for the web viewer.
!heimdall-web/public/demo/*.tif
# Test / pipeline caches
.pytest_cache/
# Stray Next dev cache created when the workspace root changed
heimdall-web/heimdall-web/
decoder_best_kaggle.zip

# Build artefacts, and the editor-assistant instruction files the dev server
# regenerates inside heimdall-web/. Neither is project source; README.md stays.
.next/
heimdall-web/.next/
heimdall-web/*.md
!heimdall-web/README.md

# Internal preparation material - scripts, slide-support packs and the
# superseded v1 report. Kept on disk, not part of the deliverable.
docs/presentation/
outputs/legacy_docs/

